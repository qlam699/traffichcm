# Camera data provider: "hcmc" uses the public HCM City traffic portal
# endpoints. "mock" uses clearly labeled local sample cameras.
TRAFFIC_CAMERA_PROVIDER=hcmc

# Official traffic portal origin. Only this hostname is contacted for metadata
# and snapshot images. Do not point this at an untrusted host.
TRAFFIC_CAMERA_BASE_URL=https://abc.com

# Optional OSM-compatible raster tiles. Leave blank to use OpenStreetMap.de
# (OSM.org's own tile servers often block automated or non-browser clients).
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=

# Upstream HTTP timeout for metadata and snapshot requests.
UPSTREAM_REQUEST_TIMEOUT_MS=10000

# In-memory cache for camera metadata. Keep this conservative.
CAMERA_METADATA_CACHE_TTL_SECONDS=60
