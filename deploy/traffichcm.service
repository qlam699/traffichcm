[Unit]
Description=traffichcm (traffic.codayroi.com)
After=network.target

[Service]
Type=simple
User=traffichcm
Group=traffichcm
WorkingDirectory=__APP_DIR__
EnvironmentFile=/etc/traffichcm.env
Environment=NODE_ENV=production
ExecStart=__APP_DIR__/node_modules/.bin/next start -H 127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
